{
  "name": "kitchenos-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=packages/db && npm run build --workspace=apps/api && npm run build --workspace=apps/web",
    "prisma:generate": "npm run generate --workspace=packages/db",
    "prisma:migrate": "npm run migrate --workspace=packages/db"
  }
}
